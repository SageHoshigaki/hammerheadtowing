# ============================================================
# Hammer Head Towing — Environment Variables
# ============================================================
# Copy this to .env and fill in real values.
# Add these same vars in Netlify → Site settings → Environment variables.

# ------ SUPABASE (browser-safe — exposed via VITE_ prefix) ------
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...your-anon-key...

# ------ SUPABASE (server-side only — Netlify Functions) ------
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...your-service-role-key...

# ------ ATTIO CRM ------
# Create an API key at https://app.attio.com → Settings → API
ATTIO_API_KEY=your-attio-api-key

# ------ TOWBOOK ------
# Public form endpoint — default is the Hammer Head public form
TOWBOOK_ENDPOINT=https://public.towbook.com/KrKN
# Set to "true" to enable Towbook form submission
TOWBOOK_ENABLED=false
